{
  "name": "reward-benefits-tracker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/reward-benefits-tracker/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/reward-benefits-tracker",
        "index": "apps/reward-benefits-tracker/src/index.html",
        "main": "apps/reward-benefits-tracker/src/main.ts",
        "tsConfig": "apps/reward-benefits-tracker/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/reward-benefits-tracker/public"
          }
        ],
        "styles": ["apps/reward-benefits-tracker/src/app/shared/styles/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/personal-site/src/app/shared/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },
        "github-pages": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/billhokc/reward-benefits-tracker/"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "reward-benefits-tracker:build:production",
          "port": 4201
        },
        "development": {
          "buildTarget": "reward-benefits-tracker:build:development",
          "port": 4201
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "reward-benefits-tracker:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "reward-benefits-tracker:build",
        "port": 4201,
        "spa": true
      }
    }
  }
}